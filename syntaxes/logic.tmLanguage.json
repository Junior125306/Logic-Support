{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "logic",
	"patterns": [
		{
			"include": "#todo-keyword"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#constants"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#variable_declarations"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#variables"
		}
	],
	"repository": {
		"todo-keyword": {
			"patterns": [
				{
					"name": "keyword.todo.logic",
					"match": "//\\s*(?i)(TODO|FIXME|XXX|HACK|BUG)\\s*:?.*$"
				}
			]
		},
		"comments": {
			"name": "comment.line.double-slash.logic",
			"match": "//.*$"
		},
		"keywords": {
			"patterns": [{
				"name": "keyword.control.logic",
				"match": "\\b(return|throw|assert|break|continue|each|try|catch|validate)\\b"
			}]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.logic",
					"match": "\\b(true|false|null)\\b"
				},
				{
					"name": "constant.numeric.logic",
					"match": "\\b[0-9]+(\\.[0-9]+)?\\b"
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.logic",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.logic",
							"match": "\\\\[\"\\\\{\\}]"
						},
						{
							"name": "variable.interpolation.logic",
							"begin": "\\{",
							"end": "\\}",
							"patterns": [
								{
									"include": "#variables"
								},
								{
									"include": "#constants"
								}
							]
						}
					]
				},
				{
					"name": "string.quoted.other.logic",
					"begin": "\\$",
					"end": "\\$",
					"patterns": [
						{
							"name": "constant.character.escape.logic",
							"match": "\\\\[\\$\\\\{\\}]"
						},
						{
							"name": "variable.interpolation.logic",
							"begin": "\\{",
							"end": "\\}",
							"patterns": [
								{
									"include": "#variables"
								},
								{
									"include": "#constants"
								}
							]
						}
					]
				}
			]
		},
		"variable_declarations": {
			"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
			"captures": {
				"1": {
					"name": "variable.declaration.logic"
				}
			}
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.logic",
					"match": "==|[=!<>]=|[<>]|[=+\\-*/%:]|=>"
				},
				{
					"name": "keyword.operator.logical.logic",
					"match": "\\b(&&|\\|\\||!)\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"name": "entity.name.function.logic",
					"match": "\\b(apply|run|remoteRun|runAsync)\\b"
				},
				{
					"name": "support.function.logic",
					"match": "\\b(info|error|debug|warn)\\b"
				}
			]
		},
		"variables": {
			"patterns": [
				{
					"name": "variable.language.logic",
					"match": "\\b(data|row|rowKey|rowIndex)\\b"
				},
				{
					"name": "support.class.logic",
					"match": "\\b(logic|log|ENV|RESOURCE|entity|sql|liuliConfig|redis|fileService)\\b"
				},
				{
					"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*\\b",
					"captures": {
						"1": {
							"name": "variable.other.logic"
						}
					}
				}
			]
		}
	},
	"scopeName": "source.logic"
}